<roblox version="4"><Item class="Workspace" referent="RBX0001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX0003"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX0002"><Properties><string name="Name">SafeSpaceContent</string><ProtectedString name="Source"><![CDATA[-- SafeSpaceContent (ModuleScript in ReplicatedStorage)
-- All the words in the Safe Space world live here, so anyone can change them
-- without touching the building or screen code.
--
-- For families and friends of people who are showing signs of harmful drug or
-- alcohol use. Phone numbers and hours were checked on 22 October 2026.
--
-- In "lines": "## " starts a heading and "- " starts a bullet point.

return {
	emergency = "Emergency? If they won't wake up, or aren't breathing normally, call 999 now.",

	-- The stop the "Who can I talk to?" button opens.
	contactsId = "talk",

	stops = {
		{
			id = "welcome",
			title = "You are not alone",
			sign = "A quiet place to find out what to do. Walk the path at your own pace.",
			colour = Color3.fromRGB(0, 105, 110),
			lines = {
				"Worrying about someone's drug or alcohol use is hard.",
				"Lots of families and friends feel this way. It is not your fault.",
				"This path has 7 stops and a quiet garden at the end. Each stop tells you one thing.",
				"## How to use this place",
				"- Walk along the path.",
				"- Press E at a sign to read more.",
				"- Sit on a bench any time you need a rest.",
				"- The red bar at the top says what to do in an emergency.",
				"- Want a break? Try the lookout trail, on the right by the start.",
				"## Please note",
				"This is a prototype made at a hackathon. It is not a real service.",
			},
		},
		{
			id = "emergency",
			title = "Is it an emergency?",
			sign = "Call 999 if they won't wake up, or their breathing is slow, noisy or has stopped.",
			colour = Color3.fromRGB(170, 30, 40),
			lines = {
				"## Look for these signs",
				"- They don't wake up when you shout or shake them.",
				"- They are snoring or making gurgling sounds.",
				"- Their breathing is very slow, or has stopped.",
				"- Their lips or skin look blue or pale.",
				"## What to do",
				"- Call 999 and ask for an ambulance.",
				"- Tell them what you think the person has taken, if you know.",
				"- Give naloxone if you have it. Stop 4 tells you about it.",
				"- If they are breathing, put them in the recovery position. Stop 3 shows you how.",
				"- If they are not breathing, the 999 call handler will help you start CPR.",
				"- Stay with them until help comes.",
				"You don't have to know it all. The person on the phone will tell you what to do.",
			},
		},
		{
			id = "recovery",
			title = "The recovery position",
			sign = "If they are breathing but won't wake up, lay them on their side. It helps them breathe.",
			colour = Color3.fromRGB(30, 80, 150),
			lines = {
				"This helps if they are breathing but won't wake up. It stops them choking.",
				"## Step by step",
				"1. They lie on their back. Kneel next to them.",
				"2. Put the arm nearest you out at a right angle.",
				"3. Put the back of their other hand against their cheek, nearest you.",
				"4. Bend their far knee up.",
				"5. Pull the bent knee towards you. They roll onto their side.",
				"6. Tilt their head back a little, so they can breathe.",
				"7. Stay with them. Keep checking their breathing.",
				"If they stop breathing, call 999. The call handler will tell you what to do.",
			},
		},
		{
			id = "naloxone",
			title = "Naloxone can save a life",
			sign = "Naloxone is a medicine. It can reverse an opioid overdose for a short time.",
			colour = Color3.fromRGB(95, 55, 140),
			lines = {
				"Opioids include heroin and methadone.",
				"Naloxone comes as a nose spray or an injection.",
				"It won't harm someone who has not taken opioids. So if you're not sure, you can still give it.",
				"It wears off. So always call 999 too.",
				"## How to get it",
				"- Ask your local drug service.",
				"- Ask at a pharmacy.",
				"- Order it online from Scottish Families: sfad.org.uk",
			},
		},
		{
			id = "you",
			title = "Look after yourself too",
			sign = "It is not your fault. You don't have to cope with this on your own.",
			colour = Color3.fromRGB(40, 105, 60),
			lines = {
				"You might feel worried, angry, tired or ashamed. All of these feelings are normal.",
				"You can't fix someone else's drug or alcohol use. But you can look after yourself.",
				"## Small things that help",
				"- Talk to someone you trust.",
				"- Try to eat, drink water and rest.",
				"- Take a break when you need to. Even 5 minutes helps.",
				"- Stop 6 has people you can talk to tonight.",
			},
		},
		{
			id = "talk",
			title = "Someone to talk to, tonight",
			sign = "Free numbers you can call, including at night and at weekends.",
			colour = Color3.fromRGB(20, 90, 120),
			lines = {
				"## Any time, day or night",
				"- Samaritans: 116 123. Talk about anything.",
				"- NHS 24: 111. If you're worried about someone's health.",
				"## Evenings and weekends",
				"- Breathing Space: 0800 83 85 87. Monday to Thursday, 6pm to 2am. Friday 6pm to Monday 6am.",
				"## For families and friends",
				"- Scottish Families Affected by Alcohol and Drugs: 08080 10 10 11. Weekdays 9am to 11pm. You can ask for a call back at weekends. Web chat at sfad.org.uk.",
				"## About drugs",
				"- Know the Score: 0800 587 5879. Weekdays 9am to 9pm. Weekends 10am to 4pm.",
				"Hours were checked on 22 October 2026. They can change.",
				"In an emergency, always call 999.",
			},
		},
		{
			id = "next",
			title = "When you're ready",
			sign = "You don't have to do everything today. Here are some small next steps.",
			colour = Color3.fromRGB(150, 75, 20),
			lines = {
				"## Talking to them",
				"- Pick a calm time to talk.",
				"- Say how you feel: \"I'm worried about you.\"",
				"- Listen more than you talk.",
				"- It's OK if it doesn't go well the first time.",
				"## Finding support near you",
				"- Scottish Families can help you find support where you live.",
				"- Your GP can help too.",
				"## Keep these safe",
				"- Save 999, 111 and 116 123 in your phone.",
			},
		},
	},

	-- The lookout trail: an obstacle course just for fun, beside the path.
	trail = {
		id = "trail",
		title = "The lookout trail",
		sign = "Want a break from thinking? Jump, balance and climb to the lookout. Or stay on the path. It's up to you.",
		colour = Color3.fromRGB(190, 95, 25),
		lines = {
			"This trail is just for fun. You can leave it any time.",
			"## How it works",
			"- Jump across the stepping stones.",
			"- Walk along the logs over the pond.",
			"- Climb the blocks. Then jump on the pink pad to bounce up to the lookout.",
			"- Slide down the other side.",
			"Press Space (or the jump button) to jump.",
			"## Falling in the water?",
			"Nothing bad happens. You go back to the last flag you reached.",
			"## Find the lights",
			"There are 6 lights on the trail. Find them all to light up the quiet garden.",
		},
	},

	-- The sign at the top of the lookout tower.
	lookout = {
		id = "lookout",
		title = "You made it to the top",
		sign = "Look how far you've come. Small steps add up.",
		colour = Color3.fromRGB(190, 95, 25),
		lines = {
			"Take a moment to look around.",
			"Every stop on the path was a small step too.",
			"When you're ready, slide down the other side. The way back to the path is at the bottom.",
		},
	},

	-- Short messages that pop up on screen. %d is replaced by a number.
	messages = {
		counter = "Lights found: %d of %d",
		lightFound = "You found a light! That's %d of %d.",
		allLights = "You found all the lights! Go to the quiet garden and see what happens.",
		flag = "You reached a flag. If you fall in the water, you'll come back here.",
		splash = "Splash! Back to the last flag. Have another go.",
	},

	-- The quiet garden at the end of the path, with the breathing exercise.
	garden = {
		id = "breathe",
		title = "Take a breath",
		sign = "Sit by the water for a while. Press E to breathe slowly with the circle.",
		colour = Color3.fromRGB(0, 105, 110),
		breaths = 6,
		lines = {},
	},
}
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX0005"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0004"><Properties><string name="Name">BuildSafeSpace</string><ProtectedString name="Source"><![CDATA[-- BuildSafeSpace (Script in ServerScriptService)
-- Builds the Safe Space world when the game starts: a calm evening path with
-- 7 stops, a stream with a bridge, a quiet garden with a gazebo, and the
-- lookout trail: an obstacle course with flags, lights to find and a slide.
-- The words come from ReplicatedStorage.SafeSpaceContent.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Content = require(ReplicatedStorage:WaitForChild("SafeSpaceContent"))

local GROUND = 0.2 -- height of the top of the grass
local STOP_GAP = 36 -- distance between stops along the path
local STREAM_Z = -100 -- the stream crosses the path between stops 3 and 4
local TRAIL_X = 80 -- the middle of the lookout trail
local WHITE = Color3.new(1, 1, 1)
local CREAM = Color3.fromRGB(250, 246, 236)
local PLASTER = Color3.fromRGB(240, 232, 218)
local INK = Color3.fromRGB(30, 30, 40)
local STONE = Color3.fromRGB(214, 206, 190)
local WOOD = Color3.fromRGB(120, 85, 60)
local WATER = Color3.fromRGB(70, 140, 200)
local HEDGE = Color3.fromRGB(55, 100, 60)
local LAMP_GLOW = Color3.fromRGB(255, 214, 170)
-- Bright block colours for the climb, like the hackathon's big screen.
local BLOCKS = {
	Color3.fromRGB(60, 190, 220),
	Color3.fromRGB(235, 110, 50),
	Color3.fromRGB(60, 110, 235),
	Color3.fromRGB(150, 70, 225),
	Color3.fromRGB(225, 70, 200),
	Color3.fromRGB(90, 210, 110),
}
local FLOWERS = {
	Color3.fromRGB(240, 200, 90),
	Color3.fromRGB(230, 140, 170),
	Color3.fromRGB(180, 160, 230),
	Color3.fromRGB(250, 250, 245),
}
local rng = Random.new(42) -- the same trees every time

-- Turn off any spawn points already in the place, so everyone starts at ours.
for _, obj in ipairs(workspace:GetDescendants()) do
	if obj:IsA("SpawnLocation") then
		obj.Enabled = false
	end
end

local world = Instance.new("Folder")
world.Name = "SafeSpaceWorld"
world.Parent = workspace

local function make(className, props, parent, attributes)
	local obj = Instance.new(className)
	if obj:IsA("BasePart") then
		obj.Anchored = true
		obj.TopSurface = Enum.SurfaceType.Smooth
		obj.BottomSurface = Enum.SurfaceType.Smooth
	end
	for key, value in pairs(props) do
		obj[key] = value
	end
	-- Attributes go on before the part appears, so player screens see them straight away.
	for key, value in pairs(attributes or {}) do
		obj:SetAttribute(key, value)
	end
	obj.Parent = parent or world
	return obj
end

-- Text that shrinks to fit its box, up to maxSize.
local function text(parent, props, maxSize)
	local label = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextColor3 = INK,
		TextWrapped = true,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
	for key, value in pairs(props) do
		label[key] = value
	end
	make("UITextSizeConstraint", { MaxTextSize = maxSize }, label)
	return label
end

local function stopZ(index)
	return -10 - (index - 1) * STOP_GAP
end

local function upright(cframe)
	-- Roblox cylinders lie along X; this stands them up.
	return cframe * CFrame.Angles(0, 0, math.rad(90))
end

local function flower(position)
	make("Part", {
		Name = "Flower",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.8, 0.8, 0.8),
		CFrame = CFrame.new(position),
		Color = FLOWERS[rng:NextInteger(1, #FLOWERS)],
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
end

-- Lighting: early evening, warm and soft.
Lighting.ClockTime = 18
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(110, 100, 120)
Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 155)
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Density = 0.3
atmosphere.Offset = 0.25
atmosphere.Color = Color3.fromRGB(230, 200, 190)
atmosphere.Decay = Color3.fromRGB(120, 100, 140)
atmosphere.Glare = 0
atmosphere.Haze = 1
atmosphere.Parent = Lighting

-- Ground, with invisible walls round the edge so nobody falls off.
make("Part", {
	Name = "Grass",
	Size = Vector3.new(600, 2, 600),
	CFrame = CFrame.new(0, GROUND - 1, -150),
	Color = Color3.fromRGB(110, 150, 95),
	Material = Enum.Material.Grass,
})
for _, wall in ipairs({
	{ Vector3.new(2, 40, 600), Vector3.new(300, 20, -150) },
	{ Vector3.new(2, 40, 600), Vector3.new(-300, 20, -150) },
	{ Vector3.new(600, 40, 2), Vector3.new(0, 20, 150) },
	{ Vector3.new(600, 40, 2), Vector3.new(0, 20, -450) },
}) do
	make("Part", { Name = "Edge", Size = wall[1], CFrame = CFrame.new(wall[2]), Transparency = 1 })
end

local stops = Content.stops
local gardenZ = stopZ(#stops) - 52

-- The path, from the start to the garden.
local pathStart, pathEnd = 30, gardenZ + 20
make("Part", {
	Name = "Path",
	Size = Vector3.new(12, 0.2, pathStart - pathEnd),
	CFrame = CFrame.new(0, GROUND + 0.1, (pathStart + pathEnd) / 2),
	Color = Color3.fromRGB(222, 205, 170),
	Material = Enum.Material.Pebble,
})

make("SpawnLocation", {
	Name = "Start",
	Size = Vector3.new(8, 0.4, 8),
	CFrame = CFrame.new(0, GROUND + 0.4, 22),
	Color = Color3.fromRGB(150, 200, 195),
	Material = Enum.Material.SmoothPlastic,
	Neutral = true,
	Duration = 0,
})

-- A pitched, tiled roof. base is the middle of the roof at eave height, and
-- the ridge runs along base's Z axis. The ends are filled with stepped plaster.
local function buildRoof(base, width, depth, rise, colour)
	local half = width / 2
	local slope = math.sqrt(half * half + rise * rise)
	local angle = math.atan(rise / half)
	for _, s in ipairs({ -1, 1 }) do
		make("Part", {
			Name = "Roof",
			Size = Vector3.new(slope + 0.4, 0.6, depth),
			CFrame = base * CFrame.new(s * half / 2, rise / 2, 0) * CFrame.Angles(0, 0, -s * angle),
			Color = colour,
			Material = Enum.Material.ClayRoofTiles,
		})
	end
	make("Part", {
		Name = "Ridge",
		Size = Vector3.new(0.9, 0.9, depth + 0.4),
		CFrame = base * CFrame.new(0, rise + 0.15, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	local steps = 4
	for _, s in ipairs({ -1, 1 }) do
		for i = 0, steps - 1 do
			make("Part", {
				Name = "Gable",
				Size = Vector3.new(width * (1 - (i + 0.6) / steps), rise / steps, 0.4),
				CFrame = base * CFrame.new(0, (i + 0.5) * rise / steps, s * (depth / 2 - 1)),
				Color = PLASTER,
				Material = Enum.Material.Plaster,
			})
		end
	end
end

-- Welcome gate over the path: stone pillars and a little tiled roof.
for _, x in ipairs({ -8, 8 }) do
	make("Part", {
		Name = "GatePillar",
		Size = Vector3.new(2.4, 14, 2.4),
		CFrame = CFrame.new(x, GROUND + 7, 10),
		Color = STONE,
		Material = Enum.Material.Cobblestone,
	})
	make("Part", {
		Name = "PillarCap",
		Size = Vector3.new(3.2, 0.8, 3.2),
		CFrame = CFrame.new(x, GROUND + 14.4, 10),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
end
buildRoof(CFrame.new(0, GROUND + 14.8, 10) * CFrame.Angles(0, math.rad(90), 0), 6, 22, 2.5, stops[1].colour)
local archPos = Vector3.new(0, GROUND + 12.4, 10)
local arch = make("Part", {
	Name = "ArchSign",
	Size = Vector3.new(20, 3.6, 1),
	CFrame = CFrame.lookAt(archPos, archPos + Vector3.new(0, 0, 1)),
	Color = stops[1].colour,
	Material = Enum.Material.SmoothPlastic,
})
for face, words in pairs({ [Enum.NormalId.Front] = "Safe Space", [Enum.NormalId.Back] = "Take your time" }) do
	local gui = make("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 40,
		LightInfluence = 0,
	}, arch)
	text(gui, {
		Text = words,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -40, 1, -20),
		Position = UDim2.new(0, 20, 0, 10),
	}, 100)
end

local function buildLantern(position, name)
	make("Part", {
		Name = "LanternPost",
		Size = Vector3.new(0.5, 6, 0.5),
		CFrame = CFrame.new(position + Vector3.new(0, 3, 0)),
		Color = Color3.fromRGB(60, 55, 60),
		Material = Enum.Material.Metal,
	})
	local glow = make("Part", {
		Name = name or "Lantern",
		Size = Vector3.new(1, 1.2, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 6.6, 0)),
		Color = LAMP_GLOW,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	make("PointLight", { Range = 14, Brightness = 0.8, Color = LAMP_GLOW }, glow)
end

-- A bench you can sit on, facing lookDir.
local function buildBench(position, lookDir)
	local cf = CFrame.lookAt(position, position + lookDir)
	make("Seat", {
		Name = "Bench",
		Size = Vector3.new(5, 0.5, 2),
		CFrame = cf * CFrame.new(0, 1.6, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	make("Part", {
		Name = "BenchBack",
		Size = Vector3.new(5, 2, 0.4),
		CFrame = cf * CFrame.new(0, 2.85, 0.9),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	for _, dx in ipairs({ -2, 2 }) do
		make("Part", {
			Name = "BenchLeg",
			Size = Vector3.new(0.4, 1.4, 1.6),
			CFrame = cf * CFrame.new(dx, 0.65, 0),
			Color = Color3.fromRGB(80, 60, 45),
			Material = Enum.Material.Wood,
		})
	end
end

-- A sign board with a short message and a "Press E" prompt.
local function buildSign(stop, cframe, label, actionText)
	local board = make("Part", {
		Name = stop.id .. "Sign",
		Size = Vector3.new(12, 8, 0.6),
		CFrame = cframe,
		Color = CREAM,
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = make("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 50,
		LightInfluence = 0,
	}, board)
	local header = make("Frame", {
		Size = UDim2.new(1, 0, 0, 130),
		BackgroundColor3 = stop.colour,
		BorderSizePixel = 0,
	}, gui)
	text(header, {
		Text = label,
		Font = Enum.Font.GothamMedium,
		TextColor3 = WHITE,
		Size = UDim2.new(1, -40, 0, 34),
		Position = UDim2.new(0, 20, 0, 12),
	}, 26)
	text(header, {
		Text = stop.title,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.new(0, 20, 0, 50),
	}, 48)
	text(gui, {
		Text = stop.sign,
		Size = UDim2.new(1, -48, 1, -220),
		Position = UDim2.new(0, 24, 0, 150),
		TextYAlignment = Enum.TextYAlignment.Top,
	}, 36)
	text(gui, {
		Text = "Press E: " .. actionText,
		Font = Enum.Font.GothamBold,
		TextColor3 = stop.colour,
		Size = UDim2.new(1, -48, 0, 40),
		Position = UDim2.new(0, 24, 1, -58),
	}, 28)

	local prompt = make("ProximityPrompt", {
		ActionText = actionText,
		ObjectText = stop.title,
		MaxActivationDistance = 14,
		RequiresLineOfSight = false,
		HoldDuration = 0,
	}, board)
	prompt:SetAttribute("SafeSpaceId", stop.id)
	return board
end

-- One stop: a little open-fronted house beside the path, with a tiled roof,
-- a back wall holding the sign, a hanging lamp and flower boxes.
local function buildStop(stop, index)
	local side = (index % 2 == 1) and -1 or 1
	local centre = Vector3.new(side * 18, GROUND, stopZ(index))
	-- Local -Z faces the path, so "front" means towards the path at every stop.
	local cf = CFrame.lookAt(centre, centre + Vector3.new(-side, 0, 0))
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end

	make("Part", { Name = "Floor", Size = Vector3.new(20, 0.6, 20), CFrame = at(0, 0.3, 0), Color = STONE, Material = Enum.Material.Slate })
	make("Part", { Name = "Step", Size = Vector3.new(6, 0.3, 2), CFrame = at(0, 0.15, -11), Color = STONE, Material = Enum.Material.Slate })
	for _, x in ipairs({ -8, 8 }) do
		for _, z in ipairs({ -8, 8 }) do
			make("Part", { Name = "Post", Size = Vector3.new(1.2, 10, 1.2), CFrame = at(x, 5.6, z), Color = WOOD, Material = Enum.Material.Wood })
		end
	end
	-- Beams along the tops of the posts, and one across the middle for the lamp.
	for _, z in ipairs({ -8, 0, 8 }) do
		make("Part", { Name = "Beam", Size = Vector3.new(17.2, 0.6, 1), CFrame = at(0, 10.9, z), Color = WOOD, Material = Enum.Material.Wood })
	end
	for _, x in ipairs({ -8, 8 }) do
		make("Part", { Name = "Beam", Size = Vector3.new(1, 0.6, 17.2), CFrame = at(x, 10.9, 0), Color = WOOD, Material = Enum.Material.Wood })
	end
	buildRoof(at(0, 10, 0) * CFrame.Angles(0, math.rad(90), 0), 22, 22, 5, stop.colour)

	-- Back wall, with a band in the stop's colour, and low side walls with flower boxes.
	make("Part", { Name = "BackWall", Size = Vector3.new(16, 10, 0.8), CFrame = at(0, 5.6, 8), Color = PLASTER, Material = Enum.Material.Plaster })
	make("Part", { Name = "Band", Size = Vector3.new(16, 1, 0.2), CFrame = at(0, 9.8, 7.5), Color = stop.colour, Material = Enum.Material.SmoothPlastic })
	for _, x in ipairs({ -8, 8 }) do
		make("Part", { Name = "LowWall", Size = Vector3.new(0.8, 3, 14.8), CFrame = at(x, 2.1, 0), Color = PLASTER, Material = Enum.Material.Plaster })
		make("Part", { Name = "FlowerBox", Size = Vector3.new(1.4, 0.6, 14), CFrame = at(x, 3.9, 0), Color = WOOD, Material = Enum.Material.Wood })
		for z = -6, 6, 2 do
			flower(at(x, 4.5, z).Position)
		end
	end

	-- A lamp hanging from the middle beam.
	make("Part", { Name = "Chain", Size = Vector3.new(0.15, 1.4, 0.15), CFrame = at(0, 9.9, 0), Color = INK, Material = Enum.Material.Metal })
	local lamp = make("Part", {
		Name = "Lamp",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.5, 1.5, 1.5),
		CFrame = at(0, 8.8, 0),
		Color = LAMP_GLOW,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	make("PointLight", { Range = 18, Brightness = 1.2, Color = LAMP_GLOW }, lamp)

	-- Planters either side of the step.
	for _, x in ipairs({ -5.5, 5.5 }) do
		make("Part", { Name = "Planter", Size = Vector3.new(3, 1.4, 1.6), CFrame = at(x, 0.7, -11), Color = WOOD, Material = Enum.Material.Wood })
		for _, dx in ipairs({ -0.9, 0, 0.9 }) do
			flower(at(x + dx, 1.7, -11).Position)
		end
	end

	buildSign(stop, at(0, 5.2, 7.3), "Stop " .. index .. " of " .. #stops, "Read more")

	-- A bench by the path, halfway to the next stop (but not in the stream).
	local benchZ = stopZ(index) - STOP_GAP / 2
	if index < #stops and math.abs(benchZ - STREAM_Z) > 6 then
		buildBench(Vector3.new(side * 10, GROUND, benchZ), Vector3.new(-side, 0, 0))
	end
end

for index, stop in ipairs(stops) do
	buildStop(stop, index)
end

-- Lanterns along both sides of the path.
for z = pathStart - 6, pathEnd, -24 do
	buildLantern(Vector3.new(-7.5, GROUND, z))
	buildLantern(Vector3.new(7.5, GROUND, z))
end

-- A stream across the path between stops 3 and 4, with a wooden bridge.
make("Part", {
	Name = "Stream",
	Size = Vector3.new(340, 0.3, 8),
	CFrame = CFrame.new(-130, GROUND + 0.1, STREAM_Z),
	Color = WATER,
	Material = Enum.Material.Glass,
	Transparency = 0.1,
})
make("Part", {
	Name = "StreamPool",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(0.3, 14, 14),
	CFrame = upright(CFrame.new(40, GROUND + 0.1, STREAM_Z)),
	Color = WATER,
	Material = Enum.Material.Glass,
	Transparency = 0.1,
})
do
	local rise, run = 1.4, 5
	local rampAngle = math.atan(rise / run)
	local rampLength = math.sqrt(rise * rise + run * run)
	make("Part", {
		Name = "BridgeDeck",
		Size = Vector3.new(12, 0.4, 6),
		CFrame = CFrame.new(0, GROUND + rise, STREAM_Z),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	})
	for _, s in ipairs({ -1, 1 }) do
		make("Part", {
			Name = "BridgeRamp",
			Size = Vector3.new(12, 0.4, rampLength + 0.2),
			CFrame = CFrame.new(0, GROUND + rise / 2, STREAM_Z + s * (3 + run / 2)) * CFrame.Angles(s * rampAngle, 0, 0),
			Color = WOOD,
			Material = Enum.Material.WoodPlanks,
		})
		make("Part", {
			Name = "BridgeRail",
			Size = Vector3.new(0.4, 0.4, 16),
			CFrame = CFrame.new(s * 6.2, GROUND + 4, STREAM_Z),
			Color = WOOD,
			Material = Enum.Material.Wood,
		})
		for _, dz in ipairs({ -8, -3, 3, 8 }) do
			make("Part", {
				Name = "BridgePost",
				Size = Vector3.new(0.4, 4, 0.4),
				CFrame = CFrame.new(s * 6.2, GROUND + 2, STREAM_Z + dz),
				Color = WOOD,
				Material = Enum.Material.Wood,
			})
		end
	end
end

-- The quiet garden: a round space with a pond, a gazebo, benches and the breathing sign.
local garden = Content.garden
make("Part", {
	Name = "GardenFloor",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(0.6, 44, 44),
	CFrame = upright(CFrame.new(0, GROUND + 0.3, gardenZ)),
	Color = STONE,
	Material = Enum.Material.Slate,
})
make("Part", {
	Name = "Pond",
	Shape = Enum.PartType.Cylinder,
	Size = Vector3.new(0.7, 16, 16),
	CFrame = upright(CFrame.new(0, GROUND + 0.35, gardenZ)),
	Color = Color3.fromRGB(90, 150, 190),
	Material = Enum.Material.Glass,
	Transparency = 0.15,
	Reflectance = 0.1,
})
for i = 0, 5 do
	local angle = math.rad(30 + i * 60)
	make("Part", {
		Name = "GazeboPost",
		Size = Vector3.new(1, 10, 1),
		CFrame = CFrame.new(math.sin(angle) * 10, GROUND + 5.6, gardenZ + math.cos(angle) * 10),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
end
for i, diameter in ipairs({ 28, 22, 16, 10 }) do
	make("Part", {
		Name = "GazeboRoof",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.9, diameter, diameter),
		CFrame = upright(CFrame.new(0, GROUND + 11 + (i - 1) * 0.9, gardenZ)),
		Color = (i % 2 == 1) and garden.colour or PLASTER,
		Material = Enum.Material.SmoothPlastic,
	})
end
local finial = make("Part", {
	Name = "GardenLantern",
	Shape = Enum.PartType.Ball,
	Size = Vector3.new(1.6, 1.6, 1.6),
	CFrame = CFrame.new(0, GROUND + 14.8, gardenZ),
	Color = LAMP_GLOW,
	Material = Enum.Material.Neon,
	CanCollide = false,
})
make("PointLight", { Range = 16, Brightness = 0.6, Color = LAMP_GLOW }, finial)
for _, degrees in ipairs({ 45, 135, 225, 315 }) do
	local angle = math.rad(degrees)
	local position = Vector3.new(math.sin(angle) * 13, GROUND + 0.6, gardenZ + math.cos(angle) * 13)
	buildBench(position, Vector3.new(0, position.Y, gardenZ) - position)
end
for i = 1, 6 do
	local angle = math.rad(30 + i * 60)
	buildLantern(Vector3.new(math.sin(angle) * 20, GROUND + 0.6, gardenZ + math.cos(angle) * 20), "GardenLantern")
end
local gardenSignPos = Vector3.new(0, GROUND + 4.6, gardenZ - 17)
buildSign(garden, CFrame.lookAt(gardenSignPos, gardenSignPos + Vector3.new(0, 0, 1)), "The quiet garden", "Start breathing")

---------------------------------------------------------------------------
-- The lookout trail: a just-for-fun obstacle course on the right of the path.
-- Stepping stones, logs over a pond, blocks to climb, a bounce pad, a lookout
-- tower and a slide. Falling in the water sends you back to the last flag.
---------------------------------------------------------------------------
local trail = Content.trail
local flagSpots = {} -- [flag number] = where you come back to
local lightCount = 0

local function strip(fromX, toX, z)
	make("Part", {
		Name = "TrailPath",
		Size = Vector3.new(toX - fromX, 0.2, 6),
		CFrame = CFrame.new((fromX + toX) / 2, GROUND + 0.1, z),
		Color = Color3.fromRGB(222, 205, 170),
		Material = Enum.Material.Pebble,
	})
end

local function flagPad(n, z)
	local pad = make("Part", {
		Name = "Flag" .. n,
		Size = Vector3.new(12, 0.4, 12),
		CFrame = CFrame.new(TRAIL_X, GROUND + 0.2, z),
		Color = STONE,
		Material = Enum.Material.Slate,
	}, nil, { Flag = n })
	make("Part", {
		Name = "FlagPole",
		Size = Vector3.new(0.4, 9, 0.4),
		CFrame = CFrame.new(TRAIL_X + 5, GROUND + 4.9, z + 5),
		Color = Color3.fromRGB(60, 55, 60),
		Material = Enum.Material.Metal,
	})
	make("Part", {
		Name = "FlagCloth",
		Size = Vector3.new(0.2, 2.4, 3.6),
		CFrame = CFrame.new(TRAIL_X + 5, GROUND + 8, z + 3.1),
		Color = trail.colour,
		Material = Enum.Material.Fabric,
	})
	flagSpots[n] = CFrame.new(TRAIL_X, GROUND + 4, z)
	return pad
end

local function waterSection(fromZ, toZ)
	local length, middle = fromZ - toZ, (fromZ + toZ) / 2
	make("Part", {
		Name = "TrailWater",
		Size = Vector3.new(28, 0.4, length),
		CFrame = CFrame.new(TRAIL_X, GROUND + 0.2, middle),
		Color = WATER,
		Material = Enum.Material.Glass,
		Transparency = 0.1,
	}, nil, { BackToFlag = true })
	for _, s in ipairs({ -1, 1 }) do
		make("Part", {
			Name = "Hedge",
			Size = Vector3.new(2, 8, length),
			CFrame = CFrame.new(TRAIL_X + s * 15, GROUND + 4, middle),
			Color = HEDGE,
			Material = Enum.Material.LeafyGrass,
		})
	end
end

-- A glowing light to find. Player screens handle the finding.
local function trailLight(position)
	lightCount = lightCount + 1
	local light = make("Part", {
		Name = "TrailLight",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = CFrame.new(position),
		Color = Color3.fromRGB(255, 220, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, nil, { SafeSpaceLight = lightCount })
	make("PointLight", { Range = 10, Brightness = 1.5, Color = Color3.fromRGB(255, 220, 90) }, light)
end

local function block(x, z, top, colour, size)
	return make("Part", {
		Name = "Block",
		Size = Vector3.new(size or 6, 1, size or 6),
		CFrame = CFrame.new(x, GROUND + top - 0.5, z),
		Color = colour,
		Material = Enum.Material.SmoothPlastic,
	})
end

-- The way in, by the start, and its sign.
strip(6, TRAIL_X - 6, 16)
local trailSignPos = Vector3.new(14, GROUND + 4.6, 26)
buildSign(trail, CFrame.lookAt(trailSignPos, Vector3.new(0, trailSignPos.Y, 22)), "Just for fun", "How it works")

-- 1. Stepping stones across the first pond.
flagPad(1, 16)
waterSection(8, -40)
for i, z in ipairs({ 4, -4, -12, -20, -28, -36 }) do
	local top = (i % 2 == 1) and 1.2 or 1.8
	make("Part", {
		Name = "SteppingStone",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(top, 4, 4),
		CFrame = upright(CFrame.new(TRAIL_X + ((i % 2 == 1) and -4 or 4), GROUND + top / 2, z)),
		Color = Color3.fromRGB(150, 145, 140),
		Material = Enum.Material.Rock,
	})
end
trailLight(Vector3.new(TRAIL_X - 4, GROUND + 3.7, -12))

-- 2. Balance logs across the second pond, with little rest spots.
flagPad(2, -48)
waterSection(-56, -104)
local logPoints = {
	Vector3.new(TRAIL_X, GROUND + 1, -53),
	Vector3.new(TRAIL_X - 8, GROUND + 1, -66),
	Vector3.new(TRAIL_X + 8, GROUND + 1, -80),
	Vector3.new(TRAIL_X - 6, GROUND + 1, -94),
	Vector3.new(TRAIL_X, GROUND + 1, -107),
}
for i = 1, #logPoints - 1 do
	local a, b = logPoints[i], logPoints[i + 1]
	make("Part", {
		Name = "Log",
		Size = Vector3.new(2, 0.8, (b - a).Magnitude + 1),
		CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.4, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	if i > 1 then
		make("Part", {
			Name = "RestSpot",
			Size = Vector3.new(4, 0.8, 4),
			CFrame = CFrame.new(a - Vector3.new(0, 0.4, 0)),
			Color = WOOD,
			Material = Enum.Material.WoodPlanks,
		})
	end
end
trailLight(logPoints[3] + Vector3.new(0, 2.5, 0))

-- 3. Floating blocks to climb, then a bounce pad up to the lookout.
flagPad(3, -112)
local climb = {
	{ TRAIL_X - 6, -124, 3 },
	{ TRAIL_X + 4, -128, 6 },
	{ TRAIL_X + 10, -136, 9 },
	{ TRAIL_X + 2, -142, 12 },
	{ TRAIL_X - 8, -146, 15 },
	{ TRAIL_X, -155, 18 },
}
for i, spot in ipairs(climb) do
	block(spot[1], spot[2], spot[3], BLOCKS[i])
end
trailLight(Vector3.new(climb[4][1], GROUND + climb[4][3] + 2.5, climb[4][2]))
local lastBlock = climb[#climb]
make("Part", {
	Name = "BouncePad",
	Size = Vector3.new(5, 0.3, 5),
	CFrame = CFrame.new(lastBlock[1], GROUND + lastBlock[3] + 0.15, lastBlock[2]),
	Color = Color3.fromRGB(240, 90, 210),
	Material = Enum.Material.Neon,
}, nil, { BouncePad = true })

-- 4. The lookout tower.
local towerZ, deckTop = -170, 30
make("Part", {
	Name = "LookoutDeck",
	Size = Vector3.new(14, 1, 14),
	CFrame = CFrame.new(TRAIL_X, GROUND + deckTop - 0.5, towerZ),
	Color = WOOD,
	Material = Enum.Material.WoodPlanks,
})
for _, dx in ipairs({ -6.5, 6.5 }) do
	for _, dz in ipairs({ -6.5, 6.5 }) do
		make("Part", {
			Name = "TowerPost",
			Size = Vector3.new(1.2, deckTop + 8, 1.2),
			CFrame = CFrame.new(TRAIL_X + dx, GROUND + (deckTop + 8) / 2, towerZ + dz),
			Color = WOOD,
			Material = Enum.Material.Wood,
		})
	end
	make("Part", {
		Name = "TowerRail",
		Size = Vector3.new(0.6, 3, 14),
		CFrame = CFrame.new(TRAIL_X + dx * 1.05, GROUND + deckTop + 1.5, towerZ),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
end
buildRoof(CFrame.new(TRAIL_X, GROUND + deckTop + 7, towerZ), 17, 17, 5, trail.colour)
local lookoutPos = Vector3.new(TRAIL_X - 5.8, GROUND + deckTop + 4.5, towerZ)
buildSign(Content.lookout, CFrame.lookAt(lookoutPos, lookoutPos + Vector3.new(1, 0, 0)), "The lookout", "Read more")
trailLight(Vector3.new(TRAIL_X + 3, GROUND + deckTop + 2.5, towerZ - 2))

-- 5. The slide down to the finish.
do
	local topZ, bottomZ, bottomY = towerZ - 7, -225, 0.6
	local drop, run = deckTop - bottomY, topZ - bottomZ
	local angle = math.atan(drop / run)
	local length = math.sqrt(drop * drop + run * run)
	local middle = Vector3.new(TRAIL_X, GROUND + (deckTop + bottomY) / 2, (topZ + bottomZ) / 2)
	local slide = CFrame.new(middle) * CFrame.Angles(-angle, 0, 0) * CFrame.new(0, -0.5, 0)
	make("Part", { Name = "Slide", Size = Vector3.new(6, 1, length), CFrame = slide, Color = BLOCKS[1], Material = Enum.Material.SmoothPlastic })
	for _, s in ipairs({ -1, 1 }) do
		make("Part", {
			Name = "SlideRail",
			Size = Vector3.new(0.5, 2, length),
			CFrame = slide * CFrame.new(s * 3.25, 1, 0),
			Color = BLOCKS[5],
			Material = Enum.Material.SmoothPlastic,
		})
	end
	for _, t in ipairs({ 0.3, 0.55, 0.8 }) do
		local height = deckTop - drop * t - 1.2
		for _, s in ipairs({ -1, 1 }) do
			make("Part", {
				Name = "SlideLeg",
				Size = Vector3.new(0.8, height, 0.8),
				CFrame = CFrame.new(TRAIL_X + s * 2.5, GROUND + height / 2, topZ - run * t),
				Color = WOOD,
				Material = Enum.Material.Wood,
			})
		end
	end
	trailLight(Vector3.new(TRAIL_X, GROUND + deckTop - drop * 0.5 + 2.5, topZ - run * 0.5))
end

-- 6. The finish, and the way back to the path.
flagPad(4, -234)
strip(6, TRAIL_X - 6, -234)
trailLight(Vector3.new(TRAIL_X - 3, GROUND + 3.4, -236))
world:SetAttribute("LightsTotal", lightCount)

-- Flags and water. Touching a flag saves your place; touching the water
-- takes you back to it. Nothing else happens: no health is lost.
local lastFlag = {}
local justMoved = {}

local function playerFrom(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	return character and Players:GetPlayerFromCharacter(character), character
end

for _, obj in ipairs(world:GetChildren()) do
	if obj:GetAttribute("Flag") then
		local n = obj:GetAttribute("Flag")
		obj.Touched:Connect(function(hit)
			local player = playerFrom(hit)
			if player and lastFlag[player] ~= n then
				lastFlag[player] = n
				player:SetAttribute("SafeSpaceFlag", n)
			end
		end)
	elseif obj:GetAttribute("BackToFlag") then
		obj.Touched:Connect(function(hit)
			local player, character = playerFrom(hit)
			if not player or justMoved[player] or not character:FindFirstChild("HumanoidRootPart") then
				return
			end
			justMoved[player] = true
			character:PivotTo(flagSpots[lastFlag[player] or 1])
			player:SetAttribute("SafeSpaceSplash", (player:GetAttribute("SafeSpaceSplash") or 0) + 1)
			task.delay(1, function()
				justMoved[player] = nil
			end)
		end)
	end
end

Players.PlayerRemoving:Connect(function(player)
	lastFlag[player] = nil
	justMoved[player] = nil
end)

-- Trees, kept well back from the path, the stops, the stream and the trail.
local function treeFits(x, z)
	if x > 26 and x < 140 and z < 34 and z > -252 then
		return false
	end
	if x < 50 and math.abs(z - STREAM_Z) < 9 then
		return false
	end
	return true
end
local greens = {
	Color3.fromRGB(70, 120, 70),
	Color3.fromRGB(90, 140, 80),
	Color3.fromRGB(60, 105, 75),
	Color3.fromRGB(110, 150, 90),
}
for _ = 1, 170 do
	local side = rng:NextInteger(0, 1) == 0 and -1 or 1
	local x = side * rng:NextNumber(34, 285)
	local z = rng:NextNumber(-440, 140)
	local height = rng:NextNumber(7, 12)
	local leaves = rng:NextNumber(9, 14)
	if treeFits(x, z) then
		make("Part", {
			Name = "Trunk",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, 1.6, 1.6),
			CFrame = upright(CFrame.new(x, GROUND + height / 2, z)),
			Color = Color3.fromRGB(105, 75, 55),
			Material = Enum.Material.Wood,
		})
		make("Part", {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(leaves, leaves, leaves),
			CFrame = CFrame.new(x, GROUND + height + leaves * 0.3, z),
			Color = greens[rng:NextInteger(1, #greens)],
			Material = Enum.Material.Grass,
		})
	end
end

-- Flowers along the edges of the path, but not on the steps, bridge or trail paths.
for _ = 1, 140 do
	local side = rng:NextInteger(0, 1) == 0 and -1 or 1
	local z = rng:NextNumber(pathEnd, pathStart)
	local clear = math.abs(z - STREAM_Z) > 9
	for index = 1, #stops do
		if math.abs(z - stopZ(index)) < 4 then
			clear = false
		end
	end
	if side == 1 and (math.abs(z - 16) < 4 or math.abs(z + 234) < 4) then
		clear = false
	end
	if clear then
		flower(Vector3.new(side * rng:NextNumber(6.6, 8.4), GROUND + 0.3, z))
	end
end
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX0008"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0007"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0006"><Properties><string name="Name">SafeSpaceUI</string><ProtectedString name="Source"><![CDATA[-- SafeSpaceUI (LocalScript in StarterPlayer > StarterPlayerScripts)
-- The on-screen parts of the Safe Space world: the emergency bar, the
-- "Who can I talk to?" button, the reading panel, the breathing exercise,
-- and the lookout trail's lights counter, messages and bounce pad.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Content = require(ReplicatedStorage:WaitForChild("SafeSpaceContent"))
local player = Players.LocalPlayer

local CREAM = Color3.fromRGB(253, 250, 244)
local INK = Color3.fromRGB(30, 30, 40)
local WHITE = Color3.new(1, 1, 1)
local EMERGENCY_RED = Color3.fromRGB(170, 30, 40)
local LIGHT_YELLOW = Color3.fromRGB(255, 220, 90)
local BOUNCE = 85 -- how hard the pink pad throws you up
local messages = Content.messages

local byId = {}
for _, stop in ipairs(Content.stops) do
	byId[stop.id] = stop
end
for _, extra in ipairs({ Content.garden, Content.trail, Content.lookout }) do
	byId[extra.id] = extra
end

local function make(className, props, parent)
	local obj = Instance.new(className)
	for key, value in pairs(props) do
		obj[key] = value
	end
	obj.Parent = parent
	return obj
end

local gui = make("ScreenGui", {
	Name = "SafeSpaceUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

-- Top of the screen: the emergency bar, always showing, and the talk button.
local topBar = make("Frame", {
	Name = "TopBar",
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
}, gui)
make("UIListLayout", {
	FillDirection = Enum.FillDirection.Vertical,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 8),
	SortOrder = Enum.SortOrder.LayoutOrder,
}, topBar)

local emergency = make("TextLabel", {
	Name = "Emergency",
	LayoutOrder = 1,
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundColor3 = EMERGENCY_RED,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextColor3 = WHITE,
	TextWrapped = true,
	Text = Content.emergency,
}, topBar)
make("UIPadding", {
	PaddingTop = UDim.new(0, 10),
	PaddingBottom = UDim.new(0, 10),
	PaddingLeft = UDim.new(0, 16),
	PaddingRight = UDim.new(0, 16),
}, emergency)

local buttonRow = make("Frame", {
	Name = "ButtonRow",
	LayoutOrder = 2,
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 44),
}, topBar)
local contacts = byId[Content.contactsId]
local talkButton = make("TextButton", {
	Name = "TalkButton",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 0),
	Size = UDim2.new(0, 220, 0, 44),
	BackgroundColor3 = contacts.colour,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextColor3 = WHITE,
	Text = "Who can I talk to?",
}, buttonRow)
make("UICorner", { CornerRadius = UDim.new(0, 10) }, talkButton)

-- How many of the trail's lights you've found.
local lightsLabel = make("TextLabel", {
	Name = "Lights",
	Visible = false,
	Position = UDim2.new(0, 12, 0, 0),
	Size = UDim2.new(0, 0, 0, 44),
	AutomaticSize = Enum.AutomaticSize.X,
	BackgroundColor3 = INK,
	BackgroundTransparency = 0.15,
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	TextColor3 = LIGHT_YELLOW,
	Text = "",
}, buttonRow)
make("UICorner", { CornerRadius = UDim.new(0, 10) }, lightsLabel)
make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, lightsLabel)

-- A short message that pops up under the buttons, then goes.
local toast = make("TextLabel", {
	Name = "Toast",
	LayoutOrder = 3,
	Visible = false,
	Size = UDim2.new(0.9, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundColor3 = INK,
	BackgroundTransparency = 0.1,
	Font = Enum.Font.GothamBold,
	TextSize = 20,
	TextColor3 = WHITE,
	TextWrapped = true,
	Text = "",
}, topBar)
make("UISizeConstraint", { MaxSize = Vector2.new(520, math.huge) }, toast)
make("UICorner", { CornerRadius = UDim.new(0, 10) }, toast)
make("UIPadding", {
	PaddingTop = UDim.new(0, 12),
	PaddingBottom = UDim.new(0, 12),
	PaddingLeft = UDim.new(0, 16),
	PaddingRight = UDim.new(0, 16),
}, toast)
local toastRun = 0
local function showToast(words)
	toastRun = toastRun + 1
	local myRun = toastRun
	toast.Text = words
	toast.Visible = true
	task.delay(4, function()
		if myRun == toastRun then
			toast.Visible = false
		end
	end)
end

-- The reading panel.
local panel = make("Frame", {
	Name = "Panel",
	Visible = false,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.56, 0),
	Size = UDim2.new(0.92, 0, 0.7, 0),
	BackgroundColor3 = CREAM,
	BorderSizePixel = 0,
}, gui)
make("UISizeConstraint", { MaxSize = Vector2.new(560, 620) }, panel)
make("UICorner", { CornerRadius = UDim.new(0, 16) }, panel)
local stroke = make("UIStroke", { Thickness = 3 }, panel)

local header = make("TextLabel", {
	Name = "Title",
	Size = UDim2.new(1, 0, 0, 64),
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	TextSize = 24,
	TextColor3 = WHITE,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
}, panel)
make("UICorner", { CornerRadius = UDim.new(0, 16) }, header)
make("UIPadding", { PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20) }, header)

local body = make("ScrollingFrame", {
	Name = "Body",
	Position = UDim2.new(0, 0, 0, 72),
	Size = UDim2.new(1, 0, 1, -148),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	CanvasSize = UDim2.new(0, 0, 0, 0),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	ScrollBarImageColor3 = INK,
}, panel)
make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, body)
make("UIPadding", {
	PaddingLeft = UDim.new(0, 20),
	PaddingRight = UDim.new(0, 24),
	PaddingTop = UDim.new(0, 8),
	PaddingBottom = UDim.new(0, 8),
}, body)

local closeButton = make("TextButton", {
	Name = "Close",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.new(1, -40, 0, 52),
	Font = Enum.Font.GothamBold,
	TextSize = 20,
	TextColor3 = WHITE,
	Text = UserInputService.KeyboardEnabled and "Close (or press Q)" or "Close",
}, panel)
make("UICorner", { CornerRadius = UDim.new(0, 10) }, closeButton)

-- The breathing exercise, shown in place of the text in the garden.
local breathe = make("Frame", {
	Name = "Breathe",
	Visible = false,
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 0, 0, 72),
	Size = UDim2.new(1, 0, 1, -148),
}, panel)
local SMALL, BIG = UDim2.fromScale(0.3, 0.3), UDim2.fromScale(0.72, 0.72)
local circle = make("Frame", {
	Name = "Circle",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.42, 0),
	Size = SMALL,
	BorderSizePixel = 0,
}, breathe)
make("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Height }, circle)
make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, circle)
local breatheText = make("TextLabel", {
	Name = "Words",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -4),
	Size = UDim2.new(1, -40, 0, 40),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 24,
	TextColor3 = INK,
	TextWrapped = true,
	Text = "",
}, breathe)

local openStop = nil
local openPart = nil
local breathRun = 0
local breathTween = nil

local function stopBreathing()
	breathRun = breathRun + 1
	if breathTween then
		breathTween:Cancel()
		breathTween = nil
	end
end

local function runBreathing(colour)
	stopBreathing()
	local myRun = breathRun
	circle.BackgroundColor3 = colour
	circle.Size = SMALL
	task.spawn(function()
		for _ = 1, Content.garden.breaths do
			for _, step in ipairs({ { "Breathe in...", BIG }, { "Breathe out...", SMALL } }) do
				if myRun ~= breathRun then
					return
				end
				breatheText.Text = step[1]
				breathTween = TweenService:Create(
					circle,
					TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ Size = step[2] }
				)
				breathTween:Play()
				task.wait(4)
			end
		end
		if myRun == breathRun then
			breatheText.Text = "Well done. Stay as long as you like."
		end
	end)
end

local function addLine(line, order)
	local words, font, size = line, Enum.Font.Gotham, 20
	if line:sub(1, 3) == "## " then
		words, font, size = line:sub(4), Enum.Font.GothamBold, 22
	elseif line:sub(1, 2) == "- " then
		words = "•  " .. line:sub(3)
	end
	make("TextLabel", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = font,
		TextSize = size,
		TextColor3 = INK,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = words,
	}, body)
end

local function closePanel()
	panel.Visible = false
	openStop = nil
	openPart = nil
	stopBreathing()
end

local function openPanel(stop, sourcePart)
	closePanel()
	openStop, openPart = stop, sourcePart
	header.Text = stop.title
	header.BackgroundColor3 = stop.colour
	stroke.Color = stop.colour
	closeButton.BackgroundColor3 = stop.colour

	for _, child in ipairs(body:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for order, line in ipairs(stop.lines) do
		addLine(line, order)
	end
	body.CanvasPosition = Vector2.new(0, 0)

	local isGarden = stop.id == Content.garden.id
	body.Visible = not isGarden
	breathe.Visible = isGarden
	if isGarden then
		runBreathing(stop.colour)
	end
	panel.Visible = true
end

-- Pressing E at a sign opens its panel; pressing E again closes it.
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local stop = byId[prompt:GetAttribute("SafeSpaceId") or ""]
	if not stop then
		return
	end
	if openStop == stop then
		closePanel()
	else
		openPanel(stop, prompt.Parent)
	end
end)

talkButton.Activated:Connect(function()
	if openStop == contacts then
		closePanel()
	else
		openPanel(contacts, nil)
	end
end)

closeButton.Activated:Connect(closePanel)

ContextActionService:BindAction("SafeSpaceClose", function(_, state)
	if state ~= Enum.UserInputState.Begin or not panel.Visible then
		return Enum.ContextActionResult.Pass
	end
	closePanel()
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)

-- Close the panel when the player walks away from the sign they opened it at.
RunService.Heartbeat:Connect(function()
	if not openPart then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and (root.Position - openPart.Position).Magnitude > 24 then
		closePanel()
	end
end)

-- The lookout trail. Lights are found on this screen only, so everyone
-- finds their own. The flags and water are handled by BuildSafeSpace.
local world = workspace:WaitForChild("SafeSpaceWorld")
local lights = {} -- light part -> where it floats, until it's found
local hooked = {}
local found = 0

local function isMe(hit)
	local character = player.Character
	return character ~= nil and hit:IsDescendantOf(character)
end

local function updateCounter()
	local total = world:GetAttribute("LightsTotal") or 0
	lightsLabel.Visible = total > 0
	lightsLabel.Text = string.format(messages.counter, found, total)
end
world:GetAttributeChangedSignal("LightsTotal"):Connect(updateCounter)
updateCounter()

local function lightUpGarden()
	for _, obj in ipairs(world:GetDescendants()) do
		if obj.Name == "GardenLantern" and obj:IsA("BasePart") then
			obj.Color = LIGHT_YELLOW
			local glow = obj:FindFirstChildOfClass("PointLight")
			if glow then
				glow.Color = LIGHT_YELLOW
				glow.Brightness = 3
				glow.Range = 28
			end
		end
	end
end

local function findLight(part)
	if not lights[part] then
		return
	end
	lights[part] = nil
	part.Transparency = 1
	local glow = part:FindFirstChildOfClass("PointLight")
	if glow then
		glow.Enabled = false
	end
	found = found + 1
	updateCounter()
	local total = world:GetAttribute("LightsTotal") or 0
	if found >= total then
		showToast(messages.allLights)
		lightUpGarden()
	else
		showToast(string.format(messages.lightFound, found, total))
	end
end

local bouncing = false
local function hook(obj)
	if hooked[obj] or not obj:IsA("BasePart") then
		return
	end
	if obj:GetAttribute("SafeSpaceLight") then
		hooked[obj] = true
		lights[obj] = obj.CFrame
		obj.Touched:Connect(function(hit)
			if isMe(hit) then
				findLight(obj)
			end
		end)
	elseif obj:GetAttribute("BouncePad") then
		hooked[obj] = true
		obj.Touched:Connect(function(hit)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if bouncing or not root or not isMe(hit) then
				return
			end
			bouncing = true
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, BOUNCE, v.Z)
			task.delay(0.6, function()
				bouncing = false
			end)
		end)
	end
end
for _, obj in ipairs(world:GetDescendants()) do
	hook(obj)
end
world.DescendantAdded:Connect(hook)

-- Lights bob and spin so they're easy to spot.
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for part, home in pairs(lights) do
		part.CFrame = home * CFrame.new(0, math.sin(t * 2) * 0.4, 0) * CFrame.Angles(0, t, 0)
	end
end)

player:GetAttributeChangedSignal("SafeSpaceFlag"):Connect(function()
	showToast(messages.flag)
end)
player:GetAttributeChangedSignal("SafeSpaceSplash"):Connect(function()
	showToast(messages.splash)
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>